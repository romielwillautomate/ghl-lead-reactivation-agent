# GoHighLevel (Settings → Private Integrations). Token starts with pit-. Scopes are listed in docs/setup.md.
GHL_API_KEY=pit-your-private-integration-token
GHL_LOCATION_ID=your-location-id
# The calendar leads book into, and the pipeline plus the stage a booked lead moves to.
# A campaign run refuses to text anyone while REPLY_WEBHOOK_SECRET, ANTHROPIC_API_KEY or any of these three are empty,
# because the leads who answer would get no reply.
GHL_CALENDAR_ID=your-calendar-id
GHL_PIPELINE_ID=your-pipeline-id
GHL_BOOKED_STAGE_ID=your-booked-stage-id
# Optional: the number texts go out from. Leave empty to use the location's default number.
GHL_FROM_NUMBER=
# Optional: your white label app domain, used for contact links in Slack
GHL_APP_URL=https://app.gohighlevel.com

# Claude (console.anthropic.com → API keys)
ANTHROPIC_API_KEY=your-anthropic-api-key
# Optional, default claude-sonnet-5. claude-haiku-4-5 is cheaper, claude-opus-5 also works. The workflow forces a
# tool call with thinking off, so the Claude Fable and Mythos models and claude-opus-5-5 do not work (a campaign run
# refuses to start with them).
ANTHROPIC_MODEL=claude-sonnet-5

# Shared secrets. Make up two long random strings.
# RUN_NOW_SECRET goes in the X-Run-Secret header when you start a campaign run.
RUN_NOW_SECRET=make-up-a-long-random-string
# REPLY_WEBHOOK_SECRET goes in the GoHighLevel workflow that forwards replies (header or customData.secret).
REPLY_WEBHOOK_SECRET=make-up-another-long-random-string

# The business, as the texts and the assistant describe it
BUSINESS_NAME=Bright Smile Dental
BUSINESS_ABOUT=a family dental practice
REACTIVATION_OFFER=your next cleaning
# Facts the assistant may use to answer questions. Anything not listed here goes to a person.
BUSINESS_FAQ=Open Monday to Friday, 8 AM to 5 PM. A cleaning takes about 45 minutes. Free parking behind the building.
# Optional: your own first text. Placeholders: {first_name} {business_name} {offer}. A STOP line is added if missing.
REACTIVATION_MESSAGE=

# Who gets texted
REACTIVATION_TAG=reactivate
# Leads with no activity for this many days are included too. 0 means tag only.
DORMANT_DAYS=90
# Optional, comma separated: tags that must never be texted (current customers, for example)
EXCLUDE_TAGS=customer-active
# Prefix for the tags the workflow adds (reactivation-sent, reactivation-booked, and so on)
TAG_PREFIX=reactivation

# How fast and when
BATCH_LIMIT=20
SEND_DELAY_SECONDS=20
SEARCH_PAGE_SIZE=100
MAX_SEARCH_PAGES=5
# Texts only go out between these hours in the lead's own time zone (BUSINESS_TZ when the contact has none)
SEND_HOUR_START=9
SEND_HOUR_END=19
BUSINESS_TZ=America/New_York
# The hourly schedule does nothing until this is true. Run Now always works.
SCHEDULE_ENABLED=false

# Booking and replies
APPOINTMENT_MINUTES=30
SLOT_SEARCH_DAYS=7
# After this many assistant replies without a booking, the lead goes to a person
MAX_AI_REPLIES=6
# false: an opt out sets DND for SMS only. true: DND for every channel.
DND_ALL_CHANNELS=false

# Optional: Slack incoming webhook for run summaries, bookings, hand offs and error alerts. Leave empty to skip Slack.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Self-hosted n8n must allow $env access in nodes
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
